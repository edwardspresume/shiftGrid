{
	"name": "shiftgrid",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:unit": "vitest",
		"test": "pnpm test:unit --run && pnpm test:e2e",
		"playwright:install": "playwright install",
		"test:e2e": "DOTENV_CONFIG_PATH=.env.test NODE_OPTIONS=--import=dotenv/config TMPDIR=/tmp playwright test",
		"test:e2e:debug": "DOTENV_CONFIG_PATH=.env.test NODE_OPTIONS=--import=dotenv/config TMPDIR=/tmp playwright test --debug",
		"test:e2e:headed": "DOTENV_CONFIG_PATH=.env.test NODE_OPTIONS=--import=dotenv/config TMPDIR=/tmp playwright test --headed",
		"test:e2e:trace": "DOTENV_CONFIG_PATH=.env.test NODE_OPTIONS=--import=dotenv/config TMPDIR=/tmp playwright test --trace on",
		"test:e2e:ui": "DOTENV_CONFIG_PATH=.env.test NODE_OPTIONS=--import=dotenv/config TMPDIR=/tmp playwright test --ui",
		"db:check": "DOTENV_CONFIG_PATH=.env drizzle-kit check --config=drizzle.config.ts",
		"db:generate": "DOTENV_CONFIG_PATH=.env drizzle-kit generate --config=drizzle.config.ts",
		"db:migrate": "DOTENV_CONFIG_PATH=.env node scripts/migrate.mjs",
		"db:migrate:test": "DOTENV_CONFIG_PATH=.env.test node scripts/migrate.mjs",
		"db:migrate:production": "DOTENV_CONFIG_PATH=.env.production node scripts/migrate.mjs",
		"db:migrate:kit": "DOTENV_CONFIG_PATH=.env drizzle-kit migrate --config=drizzle.config.ts",
		"db:copy:test-to-production": "CONFIRM_COPY_TEST_TO_PRODUCTION=replace-production node scripts/copy-test-data-to-production.mjs",
		"db:studio": "DOTENV_CONFIG_PATH=.env drizzle-kit studio --config=drizzle.config.ts",
		"db:push": "DOTENV_CONFIG_PATH=.env drizzle-kit push --config=drizzle.config.ts",
		"auth:schema": "better-auth generate --config src/lib/server/auth.ts --output src/lib/server/db/auth.schema.ts --yes",
		"auth:seed-owner": "DOTENV_CONFIG_PATH=.env node scripts/seed-owner.mjs"
	},
	"devDependencies": {
		"@eslint/js": "latest",
		"@fontsource-variable/geist": "^5.3.0",
		"@fontsource-variable/inter": "^5.3.0",
		"@internationalized/date": "^3.12.4",
		"@lucide/svelte": "^1.46.0",
		"@neondatabase/serverless": "^1.1.0",
		"@playwright/test": "^1.63.0",
		"@sveltejs/adapter-vercel": "^6.3.4",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/mcp": "^0.1.26",
		"@sveltejs/vite-plugin-svelte": "^7.3.0",
		"@tailwindcss/forms": "^0.5.11",
		"@tailwindcss/typography": "^0.5.20",
		"@tailwindcss/vite": "^4.3.3",
		"@types/node": "^24.13.5",
		"@vitest/browser-playwright": "^4.1.11",
		"auth": "^1.7.5",
		"better-auth": "~1.7.5",
		"bits-ui": "^2.19.2",
		"clsx": "^2.1.1",
		"dotenv": "^17.4.2",
		"drizzle-kit": "^0.31.10",
		"drizzle-orm": "^0.45.2",
		"eslint": "^10.10.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.23.0",
		"globals": "^17.12.0",
		"playwright": "^1.63.0",
		"prettier": "^3.9.7",
		"prettier-plugin-svelte": "^3.5.2",
		"prettier-plugin-tailwindcss": "^0.7.4",
		"shadcn-svelte": "^1.6.1",
		"svelte": "^5.57.0",
		"svelte-check": "^4.7.6",
		"tailwind-merge": "^3.7.0",
		"tailwind-variants": "^3.3.1",
		"tailwindcss": "^4.3.3",
		"tw-animate-css": "^1.4.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.70.0",
		"vite": "^8.3.0",
		"vitest": "^4.1.11",
		"vitest-browser-svelte": "^2.2.1"
	},
	"dependencies": {
		"mode-watcher": "^1.1.0",
		"valibot": "^1.5.0"
	},
	"packageManager": "pnpm@10.33.0+sha512.10568bb4a6afb58c9eb3630da90cc9516417abebd3fabbe6739f0ae795728da1491e9db5a544c76ad8eb7570f5c4bb3d6c637b2cb41bfdcdb47fa823c8649319"
}
