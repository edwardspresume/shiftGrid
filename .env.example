# Drizzle
# Copy this file to .env for local development.
# For migrations against separate databases, create ignored .env.test and
# .env.production files with the same keys but different DATABASE_URL values.
DATABASE_URL="postgres://user:password@host:port/db-name"

ORIGIN=""

# Better Auth
# For production use 32 characters and generated with high entropy
# https://www.better-auth.com/docs/installation
BETTER_AUTH_SECRET=""

# Invite-only owner seed account
SHIFTGRID_OWNER_EMAIL=""
SHIFTGRID_OWNER_PASSWORD=""
SHIFTGRID_OWNER_NAME="ShiftGrid Owner"

# Backward-compatible aliases used by `pnpm auth:seed-owner`
AUTH_SEED_EMAIL=""
AUTH_SEED_PASSWORD=""
AUTH_SEED_NAME="ShiftGrid Owner"
